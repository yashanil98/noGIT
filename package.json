{
  "name": "nogit",
  "displayName": "noGIT — Local History Timeline",
  "description": "Lightweight local snapshot history with a Google Docs-style timeline for VS Code. No Git required.",
  "version": "0.1.0",
  "publisher": "yashanil98",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashanil98/noGIT.git"
  },
  "homepage": "https://github.com/yashanil98/noGIT#readme",
  "bugs": {
    "url": "https://github.com/yashanil98/noGIT/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "keywords": [
    "local history",
    "snapshot",
    "timeline",
    "version control",
    "backup"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nogit.showTimeline",
        "title": "noGIT: Show Timeline"
      },
      {
        "command": "nogit.snapshotNow",
        "title": "noGIT: Snapshot Now"
      },
      {
        "command": "nogit.checkpoint",
        "title": "noGIT: Create Checkpoint"
      },
      {
        "command": "nogit.restoreFile",
        "title": "noGIT: Restore File from Snapshot"
      },
      {
        "command": "nogit.restoreSnapshot",
        "title": "noGIT: Restore Entire Snapshot"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nogit.restoreFile",
          "when": "false"
        },
        {
          "command": "nogit.restoreSnapshot",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "noGIT",
      "properties": {
        "nogit.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic snapshots."
        },
        "nogit.snapshotIntervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Interval in minutes between automatic snapshots."
        },
        "nogit.maxSnapshots": {
          "type": "number",
          "default": 48,
          "minimum": 1,
          "description": "Maximum snapshots to keep (oldest are pruned first)."
        },
        "nogit.snapshotFolderName": {
          "type": "string",
          "default": ".nogit",
          "description": "Folder inside workspace where snapshots are stored."
        },
        "nogit.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/.nogit/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**"
          ],
          "description": "Glob patterns to exclude from snapshots."
        }
      }
    }
  },
  "scripts": {
    "watch:tsc": "tsc -w -p .",
    "watch:esbuild": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test out/test/",
    "package": "npm run build && npx @vscode/vsce@2 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3"
  }
}
